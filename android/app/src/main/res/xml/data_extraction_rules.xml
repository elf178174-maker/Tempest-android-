<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred to a new device.

  The runtime is several hundred megabytes of downloadable components, and the
  Vortex session token is sealed by a hardware-backed Keystore key that does not
  leave the device — a restored copy could not be decrypted anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
